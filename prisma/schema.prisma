model MarketStatistic {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stat_date               DateTime              @unique @map("stat_date") @db.Date
  total_listings          Int?                  @default(0) @map("total_listings")
  active_listings         Int?                  @default(0) @map("active_listings")
  total_transactions      Int?                  @default(0) @map("total_transactions")
  total_energy_traded_kwh Decimal?              @default(0) @map("total_energy_traded_kwh") @db.Decimal(15, 4)
  total_value             Decimal?              @default(0) @map("total_value") @db.Decimal(15, 2)
  avg_price_per_kwh       Decimal?              @map("avg_price_per_kwh") @db.Decimal(10, 2)
  min_price_per_kwh       Decimal?              @map("min_price_per_kwh") @db.Decimal(10, 2)
  max_price_per_kwh       Decimal?              @map("max_price_per_kwh") @db.Decimal(10, 2)
  unique_buyers           Int?                  @default(0) @map("unique_buyers")
  unique_sellers          Int?                  @default(0) @map("unique_sellers")
