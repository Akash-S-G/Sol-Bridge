  @@map("market_statistics")
}

model PanelPrediction {
  id              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_id       String                        @map("device_id") @db.VarChar(100)
  user_id         String                        @map("user_id") @db.Uuid
  predicted_date  DateTime                      @map("predicted_date") @db.Timestamp
  predicted_value Decimal                       @map("predicted_value") @db.Decimal(10, 4)
  actual_value    Decimal?                      @map("actual_value") @db.Decimal(10, 4)
