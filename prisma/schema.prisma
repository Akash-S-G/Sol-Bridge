generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                  @unique @db.VarChar(255)
  password_hash         String                  @map("password_hash") @db.VarChar(255)
  role                  String                  @db.VarChar(20)
  full_name             String?                 @map("full_name") @db.VarChar(255)
  phone                 String?                 @db.VarChar(20)
  is_verified           Boolean?                @default(false) @map("is_verified")
  is_active             Boolean?                @default(true) @map("is_active")
  kyc_status            String?                 @default("pending") @map("kyc_status") @db.VarChar(20)
  is_verified_seller     Boolean?                @default(false) @map("is_verified_seller")
  verification_id       String?                 @map("verification_id") @db.Uuid
  verified_at           DateTime?               @map("verified_at") @db.Timestamptz
  failed_login_attempts Int?                    @default(0) @map("failed_login_attempts")
  locked_until          DateTime?               @map("locked_until") @db.Timestamptz
  last_login_at         DateTime?               @map("last_login_at") @db.Timestamptz
  created_at            DateTime?               @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?               @default(now()) @map("updated_at") @db.Timestamptz

  host                  Host?
  buyer                 Buyer?
  investor              Investor?
  wallet                Wallet?
  user_preferences      UserPreference?
  devices               Device[]
  user_addresses        UserAddress[]
  payment_methods       PaymentMethod[]
  user_documents        UserDocument[]
  energy_listings       EnergyListing[]         @relation("SellerListings")
  bought_transactions   EnergyTransaction[]     @relation("BuyerTransactions")
  sold_transactions     EnergyTransaction[]     @relation("SellerTransactions")
  transactions          Transaction[]
  wallet_transactions   WalletTransaction[]
  payments              Payment[]
  solar_verifications   SolarVerification[]     @relation("UserVerifications")
  reviewed_verifications SolarVerification[]    @relation("AdminReviewedVerifications")
  daily_statements      DailyStatement[]
  panel_predictions     PanelPrediction[]
  consumption_predictions ConsumptionPrediction[]
  anomaly_alerts        AnomalyAlert[]

  @@map("users")
}

model Host {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                  @unique @map("user_id") @db.Uuid
  solar_capacity_kw     Decimal                 @default(0) @map("solar_capacity_kw") @db.Decimal(10, 2)
  panel_brand           String?                 @map("panel_brand") @db.VarChar(100)
  panel_model           String?                 @map("panel_model") @db.VarChar(100)
  installation_date     DateTime?               @map("installation_date") @db.Date
  panel_efficiency      Decimal?                @map("panel_efficiency") @db.Decimal(5, 4)
  has_battery           Boolean?                @default(false) @map("has_battery")
  battery_capacity_kwh  Decimal?                @map("battery_capacity_kwh") @db.Decimal(10, 2)
  latitude              Decimal?                @db.Decimal(10, 8)
  longitude             Decimal?                @db.Decimal(11, 8)
  address               String?
  city                  String?                 @db.VarChar(100)
  state                 String?                 @db.VarChar(100)
  pincode               String?                 @db.VarChar(10)
  meter_id              String?                 @unique @map("meter_id") @db.VarChar(100)
  inverter_brand        String?                 @map("inverter_brand") @db.VarChar(100)
  inverter_capacity_kw  Decimal?                @map("inverter_capacity_kw") @db.Decimal(10, 2)
  roof_type             String?                 @map("roof_type") @db.VarChar(50)
  roof_orientation      String?                 @map("roof_orientation") @db.VarChar(20)
  shading_factor        Decimal?                @map("shading_factor") @db.Decimal(5, 2)
  pricing_preferences   Json?                   @default("{}") @map("pricing_preferences")
  created_at            DateTime?               @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?               @default(now()) @map("updated_at") @db.Timestamptz

  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  investor_allocations  InvestorAllocation[]
  allocations           Allocation[]

  @@map("hosts")
}

model Buyer {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String                @unique @map("user_id") @db.Uuid
  meter_id                String?               @unique @map("meter_id") @db.VarChar(100)
  monthly_avg_consumption Decimal?              @map("monthly_avg_consumption") @db.Decimal(10, 2)
  household_size          Int?                  @map("household_size")
  has_ac                  Boolean?              @default(false) @map("has_ac")
  ac_tonnage              Decimal?              @map("ac_tonnage") @db.Decimal(5, 2)
  has_ev                  Boolean?              @default(false) @map("has_ev")
  ev_battery_kwh          Decimal?              @map("ev_battery_kwh") @db.Decimal(10, 2)
  house_type              String?               @map("house_type") @db.VarChar(50)
  latitude                Decimal?              @db.Decimal(10, 8)
  longitude               Decimal?              @db.Decimal(11, 8)
  address                 String?
  city                    String?               @db.VarChar(100)
  state                   String?               @db.VarChar(100)
  pincode                 String?               @db.VarChar(10)
  preferences             Json?                 @default("{\"solar_percentage\": 70, \"max_price\": 6.5}")
  created_at              DateTime?             @default(now()) @map("created_at") @db.Timestamptz
  updated_at              DateTime?             @default(now()) @map("updated_at") @db.Timestamptz

  user                    User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  allocations             Allocation[]

  @@map("buyers")
}

model Investor {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String                    @unique @map("user_id") @db.Uuid
  total_capital       Decimal                   @default(0) @map("total_capital") @db.Decimal(12, 2)
  available_capital   Decimal                   @default(0) @map("available_capital") @db.Decimal(12, 2)
  risk_appetite       String?                   @map("risk_appetite") @db.VarChar(20)
  min_roi_target      Decimal?                  @map("min_roi_target") @db.Decimal(5, 2)
  preferred_locations Json?                     @default("[]") @map("preferred_locations")
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  updated_at          DateTime?                 @default(now()) @map("updated_at") @db.Timestamptz

  user                User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  allocations         InvestorAllocation[]

  @@map("investors")
}

model InvestorAllocation {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  investor_id             String                @map("investor_id") @db.Uuid
  host_id                 String                @map("host_id") @db.Uuid
  investment_amount       Decimal               @map("investment_amount") @db.Decimal(12, 2)
  investment_date         DateTime              @default(now()) @map("investment_date") @db.Date
  expected_roi            Decimal?              @map("expected_roi") @db.Decimal(5, 2)
  contract_duration_months Int?                 @map("contract_duration_months")
  start_date              DateTime              @map("start_date") @db.Date
  end_date                DateTime?             @map("end_date") @db.Date
  status                  String?               @default("active") @db.VarChar(20)
  total_returns_paid      Decimal?              @default(0) @map("total_returns_paid") @db.Decimal(12, 2)
  created_at              DateTime?             @default(now()) @map("created_at") @db.Timestamptz
  updated_at              DateTime?             @default(now()) @map("updated_at") @db.Timestamptz

  investor                Investor              @relation(fields: [investor_id], references: [id], onDelete: Cascade)
  host                    Host                  @relation(fields: [host_id], references: [id], onDelete: Cascade)

  @@unique([investor_id, host_id], map: "unique_investor_host")
  @@map("investor_allocations")
}

model Allocation {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  allocation_date     DateTime                  @map("allocation_date") @db.Date
  hour                Int
  host_id             String?                   @map("host_id") @db.Uuid
  buyer_id            String?                   @map("buyer_id") @db.Uuid
  planned_energy_kwh  Decimal?                  @map("planned_energy_kwh") @db.Decimal(10, 4)
  actual_energy_kwh   Decimal?                  @map("actual_energy_kwh") @db.Decimal(10, 4)
  price_per_kwh       Decimal                   @map("price_per_kwh") @db.Decimal(6, 2)
  total_amount        Decimal?                  @map("total_amount") @db.Decimal(10, 2)
  status              String?                   @default("planned") @db.VarChar(20)
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  updated_at          DateTime?                 @default(now()) @map("updated_at") @db.Timestamptz

  host                Host?                     @relation(fields: [host_id], references: [id])
  buyer               Buyer?                    @relation(fields: [buyer_id], references: [id])

  @@unique([allocation_date, hour, host_id, buyer_id], map: "unique_allocation_per_hour")
  @@map("allocations")
}

model Transaction {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_type      String                  @map("transaction_type") @db.VarChar(20)
  user_id               String?                 @map("user_id") @db.Uuid
  amount                Decimal                 @db.Decimal(10, 2)
  description           String?
  reference_id          String?                 @map("reference_id") @db.Uuid
  reference_type        String?                 @map("reference_type") @db.VarChar(50)
  balance_before        Decimal?                @map("balance_before") @db.Decimal(10, 2)
  balance_after         Decimal?                @map("balance_after") @db.Decimal(10, 2)
  status                String?                 @default("pending") @db.VarChar(20)
  payment_method        String?                 @map("payment_method") @db.VarChar(50)
  payment_gateway_txn_id String?                @map("payment_gateway_txn_id") @db.VarChar(255)
  created_at            DateTime?               @default(now()) @map("created_at") @db.Timestamptz
  completed_at          DateTime?               @map("completed_at") @db.Timestamptz

  user                  User?                   @relation(fields: [user_id], references: [id])

  @@map("transactions")
}

model Wallet {
  user_id               String                  @id @map("user_id") @db.Uuid
  balance               Decimal?                @default(0) @db.Decimal(10, 2)
  currency              String?                 @default("INR") @db.VarChar(3)
  last_transaction_at   DateTime?               @map("last_transaction_at") @db.Timestamptz
  created_at            DateTime?               @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?               @default(now()) @map("updated_at") @db.Timestamptz

  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?                   @map("user_id") @db.Uuid
  transaction_type    String                    @map("transaction_type") @db.VarChar(50)
  amount              Decimal                   @db.Decimal(12, 2)
  balance_before      Decimal?                  @map("balance_before") @db.Decimal(12, 2)
  balance_after       Decimal?                  @map("balance_after") @db.Decimal(12, 2)
  description         String?
  reference_id        String?                   @map("reference_id") @db.Uuid
  reference_type      String?                   @map("reference_type") @db.VarChar(50)
  status              String?                   @default("completed") @db.VarChar(20)
  metadata            Json?                     @default("{}")
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz

  user                User?                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Device {
  device_id           String                    @id @map("device_id") @db.VarChar(100)
  user_id             String?                   @map("user_id") @db.Uuid
  device_name         String                    @map("device_name") @db.VarChar(255)
  device_type         String                    @map("device_type") @db.VarChar(50)
  capacity_kwh        Decimal?                  @map("capacity_kwh") @db.Decimal(10, 2)
  efficiency_rating   Decimal?                  @map("efficiency_rating") @db.Decimal(5, 2)
  device_model        String?                   @map("device_model") @db.VarChar(100)
  firmware_version    String?                   @map("firmware_version") @db.VarChar(50)
  mqtt_username       String?                   @unique @map("mqtt_username") @db.VarChar(255)
  mqtt_password_hash  String?                   @map("mqtt_password_hash") @db.VarChar(255)
  status              String?                   @default("active") @db.VarChar(20)
  last_seen_at        DateTime?                 @map("last_seen_at") @db.Timestamptz
  last_reading        Json?                     @map("last_reading")
  latitude            Decimal?                  @db.Decimal(10, 8)
  longitude           Decimal?                  @db.Decimal(11, 8)
  installation_date   DateTime?                 @map("installation_date") @db.Date
  metadata            Json?                     @default("{}")
  configuration       Json?                     @default("{}")
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  updated_at          DateTime?                 @default(now()) @map("updated_at") @db.Timestamptz

  user                User?                     @relation(fields: [user_id], references: [id])
  energy_listings     EnergyListing[]

  @@map("devices")
}

model VerificationToken {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?                   @map("user_id") @db.Uuid
  token               String                    @unique @db.VarChar(255)
  token_type          String?                   @default("email_verification") @map("token_type") @db.VarChar(50)
  expires_at          DateTime                  @map("expires_at") @db.Timestamptz
  is_used             Boolean?                  @default(false) @map("is_used")
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz

  @@map("verification_tokens")
}

model DailyStatement {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String?               @map("user_id") @db.Uuid
  statement_date          DateTime              @map("statement_date") @db.Date
  total_cost_or_earnings  Decimal?              @map("total_cost_or_earnings") @db.Decimal(10, 2)
  total_energy_kwh        Decimal?              @map("total_energy_kwh") @db.Decimal(10, 4)
  wallet_balance_before   Decimal?              @map("wallet_balance_before") @db.Decimal(10, 2)
  wallet_balance_after    Decimal?              @map("wallet_balance_after") @db.Decimal(10, 2)
  statement_data          Json?                 @map("statement_data")
  created_at              DateTime?             @default(now()) @map("created_at") @db.Timestamptz

  user                    User?                 @relation(fields: [user_id], references: [id])

  @@map("daily_statements")
}

model UserAddress {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?                   @map("user_id") @db.Uuid
  address_type        String?                   @default("home") @map("address_type") @db.VarChar(20)
  address_line1       String                    @map("address_line1")
  address_line2       String?                   @map("address_line2")
  city                String                    @db.VarChar(100)
  state               String                    @db.VarChar(100)
  postal_code         String                    @map("postal_code") @db.VarChar(20)
  country             String?                   @default("India") @db.VarChar(100)
  latitude            Decimal?                  @db.Decimal(10, 8)
  longitude           Decimal?                  @db.Decimal(11, 8)
  is_default          Boolean?                  @default(false) @map("is_default")
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  updated_at          DateTime?                 @default(now()) @map("updated_at") @db.Timestamptz

  user                User?                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model PaymentMethod {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?                 @map("user_id") @db.Uuid
  method_type           String                  @map("method_type") @db.VarChar(20)
  card_last4            String?                 @map("card_last4") @db.VarChar(4)
  card_brand            String?                 @map("card_brand") @db.VarChar(20)
  card_exp_month        Int?                    @map("card_exp_month")
  card_exp_year         Int?                    @map("card_exp_year")
  upi_id                String?                 @map("upi_id") @db.VarChar(100)
  bank_name             String?                 @map("bank_name") @db.VarChar(100)
  account_number_last4  String?                 @map("account_number_last4") @db.VarChar(4)
  ifsc_code             String?                 @map("ifsc_code") @db.VarChar(20)
  wallet_provider       String?                 @map("wallet_provider") @db.VarChar(50)
  is_default            Boolean?                @default(false) @map("is_default")
  is_verified           Boolean?                @default(false) @map("is_verified")
  metadata              Json?                   @default("{}")
  created_at            DateTime?               @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?               @default(now()) @map("updated_at") @db.Timestamptz

  user                  User?                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  energy_transactions   EnergyTransaction[]

  @@map("payment_methods")
}

model UserDocument {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?                   @map("user_id") @db.Uuid
  document_type       String                    @map("document_type") @db.VarChar(50)
  document_name       String                    @map("document_name") @db.VarChar(255)
  file_path           String                    @map("file_path")
  file_size           Int?                      @map("file_size")
  mime_type           String?                   @map("mime_type") @db.VarChar(100)
  verification_status String?                   @default("pending") @map("verification_status") @db.VarChar(20)
  rejection_reason    String?                   @map("rejection_reason")
  verified_at         DateTime?                 @map("verified_at") @db.Timestamptz
  verified_by         String?                   @map("verified_by") @db.Uuid
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  updated_at          DateTime?                 @default(now()) @map("updated_at") @db.Timestamptz

  user                User?                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_documents")
}

model UserPreference {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                  @unique @map("user_id") @db.Uuid
  notifications_push    Boolean?                @default(true) @map("notifications_push")
  notifications_email   Boolean?                @default(true) @map("notifications_email")
  notifications_sms     Boolean?                @default(false) @map("notifications_sms")
  notifications_marketing Boolean?              @default(true) @map("notifications_marketing")
  security_two_factor   Boolean?                @default(false) @map("security_two_factor")
  security_biometric    Boolean?                @default(false) @map("security_biometric")
  theme                 String?                 @default("light") @db.VarChar(10)
  language              String?                 @default("en") @db.VarChar(5)
  currency              String?                 @default("INR") @db.VarChar(3)
  timezone              String?                 @default("Asia/Kolkata") @db.VarChar(50)
  auto_update           Boolean?                @default(true) @map("auto_update")
  analytics_enabled     Boolean?                @default(true) @map("analytics_enabled")
  created_at            DateTime?               @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?               @default(now()) @map("updated_at") @db.Timestamptz

  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model EnergyListing {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id           String?                   @map("seller_id") @db.Uuid
  device_id           String?                   @map("device_id") @db.VarChar(100)
  energy_amount_kwh   Decimal                   @map("energy_amount_kwh") @db.Decimal(10, 4)
  price_per_kwh       Decimal                   @map("price_per_kwh") @db.Decimal(10, 2)
  available_from      DateTime                  @map("available_from") @db.Timestamptz
  available_to        DateTime                  @map("available_to") @db.Timestamptz
  listing_type        String?                   @default("spot") @map("listing_type") @db.VarChar(20)
  status              String?                   @default("active") @db.VarChar(20)
  min_purchase_kwh    Decimal?                  @default(1.0) @map("min_purchase_kwh") @db.Decimal(10, 4)
  location_latitude   Decimal?                  @map("location_latitude") @db.Decimal(10, 8)
  location_longitude  Decimal?                  @map("location_longitude") @db.Decimal(11, 8)
  renewable_cert      Boolean?                  @default(true) @map("renewable_cert")
  description         String?
  metadata            Json?                     @default("{}")
  views_count         Int?                      @default(0) @map("views_count")
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  updated_at          DateTime?                 @default(now()) @map("updated_at") @db.Timestamptz

  seller              User?                     @relation("SellerListings", fields: [seller_id], references: [id], onDelete: Cascade)
  device              Device?                   @relation(fields: [device_id], references: [device_id])
  transactions        EnergyTransaction[]

  @@map("energy_listings")
}

model EnergyTransaction {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id            String?                 @map("listing_id") @db.Uuid
  buyer_id              String?                 @map("buyer_id") @db.Uuid
  seller_id             String?                 @map("seller_id") @db.Uuid
  energy_amount_kwh     Decimal                 @map("energy_amount_kwh") @db.Decimal(10, 4)
  price_per_kwh         Decimal                 @map("price_per_kwh") @db.Decimal(10, 2)
  total_price           Decimal                 @map("total_price") @db.Decimal(12, 2)
  platform_fee          Decimal?                @default(0) @map("platform_fee") @db.Decimal(10, 2)
  status                String?                 @default("pending") @db.VarChar(20)
  payment_method_id     String?                 @map("payment_method_id") @db.Uuid
  payment_status        String?                 @default("pending") @map("payment_status") @db.VarChar(20)
  payment_transaction_id String?                @map("payment_transaction_id") @db.VarChar(255)
  delivery_start        DateTime?               @map("delivery_start") @db.Timestamptz
  delivery_end          DateTime?               @map("delivery_end") @db.Timestamptz
  delivery_status       String?                 @default("pending") @map("delivery_status") @db.VarChar(20)
  energy_delivered_kwh  Decimal?                @map("energy_delivered_kwh") @db.Decimal(10, 4)
  rating                Int?
  review                String?
  metadata              Json?                   @default("{}")
  created_at            DateTime?               @default(now()) @map("created_at") @db.Timestamptz
  updated_at            DateTime?               @default(now()) @map("updated_at") @db.Timestamptz

  listing               EnergyListing?          @relation(fields: [listing_id], references: [id])
  buyer                 User?                   @relation("BuyerTransactions", fields: [buyer_id], references: [id], onDelete: SetNull)
  seller                User?                   @relation("SellerTransactions", fields: [seller_id], references: [id], onDelete: SetNull)
  payment_method        PaymentMethod?          @relation(fields: [payment_method_id], references: [id])

  @@map("energy_transactions")
}

model Payment {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?                   @map("user_id") @db.Uuid
  amount              Decimal                   @db.Decimal(12, 2)
  currency            String?                   @default("INR") @db.VarChar(3)
  payment_type        String                    @map("payment_type") @db.VarChar(30)
  status              String?                   @default("pending") @db.VarChar(20)
  gateway             String?                   @db.VarChar(20)
  gateway_order_id    String?                   @map("gateway_order_id") @db.VarChar(255)
  gateway_payment_id  String?                   @map("gateway_payment_id") @db.VarChar(255)
  reference_id        String?                   @map("reference_id") @db.Uuid
  reference_type      String?                   @map("reference_type") @db.VarChar(50)
  metadata            Json?                     @default("{}")
  created_at          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  completed_at        DateTime?                 @map("completed_at") @db.Timestamptz
  updated_at          DateTime?                 @default(now()) @map("updated_at") @db.Timestamptz

  user                User?                     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("payments")
}

